@startuml RuneVault
skinparam classAttributeIconSize 0
hide empty members

' ============================ MVC CORE ============================
class Game {
  +Game(istream& = cin, ostream& = cout)
  +useLayout(layout : const LoadedLayout&) : void
  +run() : int
  -promptClassSelection() : char
  -resetRun() : void
  -startNewRun(classKey : char) : void
  -playLoop() : SessionAction
  -dispatchCommand(cmd : string) : bool
  -reportOutcome() : void
  -playAgainPrompt() : bool
  -redraw() : void
  -buildOverlay() : RenderOverlay
  -buildStatus() : StatusInfo
  -in_ : istream&
  -out_ : ostream&
  -model_ : Model
  -view_ : View
  -hasLayout_ : bool
  -layout_ : LoadedLayout
}

enum SessionAction {
  Quit
  Restart
  RunEnded
}

class Model {
  +Model()
  +arcanist() : shared_ptr<Arcanist>&
  +setArcanist(a : shared_ptr<Arcanist>) : void
  +activeArcanist() : ArcanistComponent*
  +setActiveArcanist(c : shared_ptr<ArcanistComponent>) : void
  +resetActiveArcanistToBase() : void
  +effectivePwr() : int
  +effectiveWr() : int
  +level() : Level*
  +setLevel(l : unique_ptr<Level>) : void
  +setLayout(l : const LoadedLayout*) : void
  +buildCurrentLevel() : void
  +levelNumber() : int
  +arcanistPosition() : Position
  +moveArcanist(d : Direction) : bool
  +useScroll(d : Direction) : bool
  +descend() : bool
  +onStairway() : bool
  +tryDescend() : bool
  +handleAttack(d : Direction) : bool
  +spectreDamageIfHit(s : const Spectre&) : int
  +resolveSpectreAttack(s : Spectre&) : bool
  +isHostile(s : const Spectre&) : bool
  +advanceSpectres() : void
  +runeFragmentTotal() : int
  +addRuneFragments(amount : int) : void
  +revealStairwayIfCarryingGem() : void
  +markScrollIdentified(t : ScrollType) : void
  +isScrollIdentified(t : ScrollType) : bool
  -baseArcanist_ : shared_ptr<Arcanist>
  -activeArcanist_ : shared_ptr<ArcanistComponent>
  -level_ : unique_ptr<Level>
  -layout_ : const LoadedLayout*
  -levelNumber_ : int
  -runeFragmentTotal_ : int
  -arcanistPos_ : Position
  -identifiedScrolls_ : set<ScrollType>
  -runState_ : RunState
  -carryingCipherGem_ : bool
  -carryingAegisCloak_ : bool
  -promoted_ : bool
}

enum RunState {
  Playing
  Won
  Lost
}

class View {
  +View(ansiColour : bool = false)
  +renderFrame(l : const Level&, o : const RenderOverlay&) : string
  +renderFrame(l : const Level&, o : const RenderOverlay&, s : const StatusInfo&) : string
  +render(os : ostream&, l : const Level&, o : const RenderOverlay&) : void
  -cellGlyph(b : const Board&, p : const Position&) : char
  -wallGlyph(b : const Board&, p : const Position&) : char
  -decorate(glyph : char) : string
  -ansiColour_ : bool
}

class StatusInfo <<struct>> {
  className
  fp
  maxFp
  pwr
  wr
  runeFragmentTotal
  messages
}

class RenderOverlay <<struct>> {
  glyphs : vector<pair<Position,char>>
}

' ======================= ARCANIST + STRATEGY =======================
class Arcanist {
  +Arcanist(fp, pwr, wr : int)
  +Arcanist(fp, pwr, wr : int, s : unique_ptr<ArcanistClassStrategy>)
  +fp() : int
  +maxFp() : int
  +pwr() : int
  +wr() : int
  +isDead() : bool
  +reduceFp(amount : int) : void
  +applyDamage(rawDamage : int) : void
  +healUpTo(amount : int) : void
  +loseUpTo(amount : int) : void
  +addPwr(delta : int) : void
  +addWr(delta : int) : void
  +applyPromotionBonus(fp, pwr, wr : int) : void
  +hasStrategy() : bool
  +strategy() : const ArcanistClassStrategy&
  +setStrategy(s : unique_ptr<ArcanistClassStrategy>) : void
  -fp_ : int
  -maxFp_ : int
  -pwr_ : int
  -wr_ : int
  -strategy_ : unique_ptr<ArcanistClassStrategy>
}

abstract class ArcanistClassStrategy {
  +{abstract} scoreModifier(raw : int) : int
  +{abstract} scrollEffectModifier(t : ScrollType, baseDelta : int) : int
  +{abstract} damageTakenModifier(incoming : int) : int
  +{abstract} className() : string
  +{abstract} classKey() : char
}

class SageStrategy
class HexbladeStrategy
class WardenStrategy
class VoidwalkerStrategy
class ArchmageStrategy
class WarlockStrategy
class BastionStrategy
class VoidlordStrategy

class ArcanistFactory {
  +{static} create(classKey : char) : shared_ptr<Arcanist>
}

' ===================== DECORATOR (SCROLL EFFECTS) =====================
abstract class ArcanistComponent {
  +{abstract} effPwr() : int
  +{abstract} effWr() : int
  +{abstract} base() : Arcanist&
}

class BaseArcanistComponent {
  +BaseArcanistComponent(a : shared_ptr<Arcanist>)
  +effPwr() : int
  +effWr() : int
  +base() : Arcanist&
  -arcanist_ : shared_ptr<Arcanist>
}

abstract class ScrollDecorator {
  +ScrollDecorator(inner : shared_ptr<ArcanistComponent>)
  #inner_ : shared_ptr<ArcanistComponent>
}

class SurgePower {
  -delta_ : int
}
class FortifyWard {
  -delta_ : int
}
class SapPower {
  -delta_ : int
}
class ErodeWard {
  -delta_ : int
}

' ============================ LEVEL / BOARD ============================
class Level {
  +Level(board : Board)
  +board() : const Board&
  +stairway() : Position
  +setStairway(p : const Position&) : void
  +stairwayRevealed() : bool
  +setStairwayRevealed(r : bool) : void
  +addItem(i : unique_ptr<Item>) : void
  +items() : const vector<unique_ptr<Item>>&
  +itemAt(p : const Position&) : Item*
  +removeItemAt(p : const Position&) : unique_ptr<Item>
  +addSpectre(s : unique_ptr<Spectre>) : void
  +spectres() : const vector<unique_ptr<Spectre>>&
  +spectreAt(p : const Position&) : Spectre*
  +removeDeadSpectres() : void
  -board_ : Board
  -stairway_ : Position
  -stairwayRevealed_ : bool
  -items_ : vector<unique_ptr<Item>>
  -spectres_ : vector<unique_ptr<Spectre>>
}

class "makeDefaultBoard()" as LevelFactory <<free function>>

class Board {
  +Board(rows : int = 25, cols : int = 79)
  +rows() : int
  +cols() : int
  +inBounds(p : const Position&) : bool
  +at(p : const Position&) : const Cell&
  +setCell(p : const Position&, type : CellType, chamberId : int = kNoChamber) : void
  +chamberIds() : vector<int>
  +chamberFloorTiles(chamberId : int) : vector<Position>
  +walkableNeighbours(p : const Position&) : vector<Position>
  +floorNeighboursInChamber(p : const Position&, chamberId : int) : vector<Position>
  -rows_ : int
  -cols_ : int
  -grid_ : vector<vector<Cell>>
}

class Cell <<struct>> {
  +type : CellType
  +chamberId : int
  +isWalkable() : bool
  +canHost() : bool
}

enum CellType {
  Wall
  Archway
  Corridor
  Floor
  Stairway
}

class Geometry <<namespace/utility>> {
  +{static} step(p : const Position&, d : Direction) : Position
  +{static} neighbours(p : const Position&) : array<Position,8>
  +{static} isAdjacent(a, b : const Position&) : bool
  +{static} parse(token : string) : Direction
}

class Position <<struct>> {
  +row : int
  +col : int
}

enum Direction {
  No
  So
  Ea
  We
  Ne
  Nw
  Se
  Sw
}

' ============================ ITEMS + STATE ============================
abstract class Item {
  +{abstract} symbol() : char
  +position() : Position
  +setPosition(p : const Position&) : void
  +{abstract} onWalkOver(model : Model&) : bool
  +blocksArcanist() : bool
  #position_ : Position
}

class RuneFragment {
  +RuneFragment(value : int)
  +RuneFragment(grade : FragmentGrade)
  +value() : int
  -value_ : int
}

class Scroll {
  +Scroll(type : ScrollType)
  +scrollType() : ScrollType
  -type_ : ScrollType
}

abstract class GuardedItem {
  +GuardedItem(startUnlocked : bool = false)
  +isUnlocked() : bool
  +onAnchorDeath() : void
  +onWalkOver(model : Model&) : bool
  +tryCollect(model : Model&) : bool
  +collected() : bool
  #{abstract} applyCollectionEffect(model : Model&) : void
  #{abstract} collectionMessage() : string
  -state_ : unique_ptr<GuardState>
  -collected_ : bool
}

class ShardCoffer {
  +value() : int
}

class AegisCloak
class CipherGem

abstract class GuardState {
  +{abstract} canCollect() : bool
}
class LockedState
class UnlockedState

enum ScrollType {
  AttuneFocus
  SurgePower
  FortifyWard
  DrainFocus
  SapPower
  ErodeWard
}

enum FragmentGrade {
  CommonShard
  ResonantShard
  LichCache
  ShardCoffer
}

' ======================= SPECTRES + VISITOR/FACTORY =======================
abstract class Spectre {
  +Spectre(t : SpectreType, fp, pwr, wr, spawnChamber : int, pos : Position)
  +{abstract} accept(v : CombatVisitor&) : void
  +{abstract} symbol() : char
  +type() : SpectreType
  +fp() : int
  +pwr() : int
  +wr() : int
  +takeDamage(dmg : int) : void
  +isDead() : bool
  +spawnChamber() : int
  +position() : Position
  +moveTo(p : Position) : void
  +isMobile() : bool
  +guardedItemPosition() : Position
  +setGuardedItemPosition(p : const Position&) : void
  +runeDrop() : int
  +isDefaultHostile() : bool
  +carriesCipherGem() : bool
  +setCarriesCipherGem(v : bool) : void
  -type_ : SpectreType
  -fp_ : int
  -pwr_ : int
  -wr_ : int
  -spawnChamber_ : int
  -pos_ : Position
  -guardedItemPos_ : Position
  -carriesCipherGem_ : bool
}

class GenericSpectre {
  -symbol_ : char
}

class Wraith
class Banshee
class Revenant
class Shade

class Lich {
  +runeDrop() : int
  +isDefaultHostile() : bool
}

class VaultAnchor {
  +isMobile() : bool
  +runeDrop() : int
  +isDefaultHostile() : bool
}

class SpecterLord

enum SpectreType {
  Wraith
  Banshee
  Revenant
  Shade
  Lich
  VaultAnchor
  SpecterLord
}

class SpectreFactory {
  +create(t : SpectreType, chamberId : int, pos : Position) : unique_ptr<Spectre>
  +createRandom(chamberId : int, pos : Position) : unique_ptr<Spectre>
}

class CombatVisitor {
  +CombatVisitor(model : Model&)
  +visit(s : Wraith&) : void
  +visit(s : Banshee&) : void
  +visit(s : Revenant&) : void
  +visit(s : Shade&) : void
  +visit(s : Lich&) : void
  +visit(s : VaultAnchor&) : void
  +visit(s : SpecterLord&) : void
  -model_ : Model&
}

' ============================ SUPPORT / SERVICES ============================
class Spawner {
  +populate(model : Model&) : void
  +populateActorsOnly(model : Model&) : void
  +{static} chooseAegisLevel() : int
  -placeArcanist(model : Model&, level : Level&) : void
  -placeStairway(model : Model&, level : Level&) : void
  -placeScrolls(model : Model&, level : Level&) : void
  -placeFragments(model : Model&, level : Level&) : void
  -placeSpectres(model : Model&, level : Level&) : void
  -placeAegisCloak(model : Model&, level : Level&) : void
  -selectCipherGemCarrier(level : Level&) : void
  -placeGuarded(level : Level&, item : unique_ptr<GuardedItem>, chamberId : int) : GuardedItem*
  -occupied_ : set<pair<int,int>>
  -arcanistChamber_ : int
}

class LayoutLoader {
  +{static} loadFromFile(path : string) : LoadedLayout
  +{static} loadFromString(contents : string) : LoadedLayout
  +{static} buildLevel(loaded : const LoadedLayout&, levelIndex : int) : unique_ptr<Level>
  +{static} makeItemForDigit(digit : char) : unique_ptr<Item>
}

class LoadedLayout <<struct>> {
  +ok : bool
  +error : string
  +boards : array<Board,5>
  +items : array<vector<ItemPlacement>,5>
}

class ItemPlacement <<struct>> {
  +position : Position
  +digit : char
}

class Combat <<namespace/utility>> {
  +{static} computeDamage(attackerPwr, defenderWr : int) : int
  +{static} applyDamageTakenOrdering(base : int, isWarden, carryingAegis : bool) : int
}

class NotificationLog <<singleton>> {
  +{static} instance() : NotificationLog&
  +push(message : string) : void
  +messages() : const vector<string>&
  +displayMessages() : vector<string>
  +clear() : void
  +empty() : bool
  -messages_ : vector<string>
}

' ============================ RELATIONSHIPS ============================
' -- MVC ownership (composition = by value / unique_ptr) --
Game *-- "1" Model
Game *-- "1" View
Game *-- "1" LoadedLayout
Game ..> ArcanistFactory : uses
Game ..> Spawner : uses
Game ..> LayoutLoader : uses

Model o-- "0..1" Arcanist : baseArcanist (shared_ptr)
Model *-- "0..1" ArcanistComponent : activeArcanist chain head
Model *-- "0..1" Level : level (unique_ptr)
Model --> "0..1" LoadedLayout : layout (non-owning)
Model ..> Spawner : uses
Model ..> CombatVisitor : creates on attack
Model ..> Combat : uses
Model ..> LayoutLoader : buildCurrentLevel
Model ..> NotificationLog : notify
Model ..> Spectre : combat / movement

View ..> Level : renders
View ..> Board
View ..> StatusInfo
View ..> RenderOverlay

' -- Arcanist + Strategy pattern --
Arcanist *-- "0..1" ArcanistClassStrategy : strategy (unique_ptr)
ArcanistClassStrategy <|-- SageStrategy
ArcanistClassStrategy <|-- HexbladeStrategy
ArcanistClassStrategy <|-- WardenStrategy
ArcanistClassStrategy <|-- VoidwalkerStrategy
ArcanistClassStrategy <|-- ArchmageStrategy
ArcanistClassStrategy <|-- WarlockStrategy
ArcanistClassStrategy <|-- BastionStrategy
ArcanistClassStrategy <|-- VoidlordStrategy
ArcanistFactory ..> Arcanist : creates
ArcanistFactory ..> ArcanistClassStrategy : attaches

' -- Decorator pattern (scroll effects) --
ArcanistComponent <|-- BaseArcanistComponent
ArcanistComponent <|-- ScrollDecorator
ScrollDecorator o-- "1" ArcanistComponent : inner_ (chain)
ScrollDecorator <|-- SurgePower
ScrollDecorator <|-- FortifyWard
ScrollDecorator <|-- SapPower
ScrollDecorator <|-- ErodeWard
BaseArcanistComponent o-- "1" Arcanist : adapts (shared_ptr)

' -- Level / Board / Cell composition --
Level *-- "1" Board
Level *-- "0..*" Item
Level *-- "0..*" Spectre
LevelFactory ..> Board : builds
Board *-- "rows*cols" Cell
Board ..> Geometry : uses
Cell --> CellType
Geometry ..> Position
Geometry ..> Direction

' -- Item hierarchy + State pattern --
Item <|-- RuneFragment
Item <|-- Scroll
Item <|-- GuardedItem
GuardedItem <|-- ShardCoffer
GuardedItem <|-- AegisCloak
GuardedItem <|-- CipherGem
GuardedItem *-- "1" GuardState : state (unique_ptr)
GuardState <|-- LockedState
GuardState <|-- UnlockedState
Item ..> Model : onWalkOver
Scroll --> ScrollType
RuneFragment ..> FragmentGrade

' -- Spectre hierarchy + Visitor + Factory --
Spectre <|-- GenericSpectre
Spectre <|-- Wraith
Spectre <|-- Banshee
Spectre <|-- Revenant
Spectre <|-- Shade
Spectre <|-- Lich
Spectre <|-- VaultAnchor
Spectre <|-- SpecterLord
Spectre --> SpectreType
Spectre ..> CombatVisitor : accept (double dispatch)
SpectreFactory ..> Spectre : creates
CombatVisitor o-- "1" Model
CombatVisitor ..> Spectre : visit(concrete)

' -- Spawner services --
Spawner ..> Model
Spawner ..> Level
Spawner ..> SpectreFactory
Spawner ..> GuardedItem
Spawner ..> Board

' -- Layout loading --
LayoutLoader ..> LoadedLayout : produces
LayoutLoader ..> Item : makeItemForDigit
LayoutLoader ..> Level : buildLevel
LoadedLayout *-- "5" Board
LoadedLayout *-- "0..*" ItemPlacement
@enduml